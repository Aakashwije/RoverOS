<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen, shown until the Flutter engine draws its first
     frame. Painted in the app's own dark background so the handover to the
     Dart splash is invisible — a white flash before a near-black dashboard is
     the most jarring thing an app can open with. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/roveros_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
